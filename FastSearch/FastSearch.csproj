<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>FastSearch</Title>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Company>MILL5</Company>
		<Copyright>Copyright © MILL5, LLC 2021</Copyright>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/MILL5/FastSearch</RepositoryUrl>
		<PackageProjectUrl>https://github.com/MILL5/FastSearch</PackageProjectUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReleaseNotes>1.1.3: synchronizes release and platform references in the README and documentation, clarifies selected-algorithm search timing, and pins compatible MAUI/Xcode versions in sample CI. Includes the MAUI desktop sample and screenshot introduced in 1.1.2. Library algorithms and recorded benchmark measurements are unchanged.</PackageReleaseNotes>
		<Authors>MILL5</Authors>
		<Description>Fast, low-memory, case-insensitive substring (contains) search over in-memory collections of objects. NGramSearch indexes 1M items in about 1 s with 47 MiB and answers typical queries in about 5 µs.</Description>
		<PackageTags>fast;search;string;substring;contains;autocomplete;typeahead;ngram;suffix-array;trie;algorithm;hash;lookups</PackageTags>
		<PackageIcon>fastsearch.png</PackageIcon>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>1.1.3</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<None Include="fastsearch.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- Only for the IParallelism parameter on CharSequenceSearch, HashSearch and LinqSearch (kept for API compatibility). -->
		<PackageReference Include="Pineapple" Version="1.0.41" />
	</ItemGroup>

</Project>
