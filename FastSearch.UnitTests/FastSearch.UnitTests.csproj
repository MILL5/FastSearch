<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UsesPasswordData>true</UsesPasswordData>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="NamesTest.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NamesTest.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSearch\FastSearch.csproj" />
    <Compile Include="../PasswordSearch/MainViewModel.cs" Link="Native/MainViewModel.cs" />
    <Compile Include="../PasswordSearch/TimerScope.cs" Link="Native/TimerScope.cs" />
  </ItemGroup>

</Project>
